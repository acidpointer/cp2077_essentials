diff --git a/src/App/Extensions/Attachment/HookProtection.hpp b/src/App/Extensions/Attachment/HookProtection.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..9c7ca9472de8d118c589d4effbd9b5e53567093e
--- /dev/null
+++ b/src/App/Extensions/Attachment/HookProtection.hpp
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+
+namespace App
+{
+struct ProtectedHook
+{
+    void (*attach)(); // Throws on failure.
+    bool (*detach)(); // An already detached hook counts as success.
+};
+
+// Startup/shutdown only. This does not make unloading code during callbacks safe.
+template<std::size_t TGuards, std::size_t TConsumers>
+struct HookProtection
+{
+    std::array<ProtectedHook, TGuards> guards;
+    std::array<ProtectedHook, TConsumers> consumers;
+
+    void Attach() const
+    {
+        try
+        {
+            for (const auto& hook : guards)
+                hook.attach();
+            for (const auto& hook : consumers)
+                hook.attach();
+        }
+        catch (...)
+        {
+            Detach();
+            throw;
+        }
+    }
+
+    bool Detach() const
+    {
+        bool detached = true;
+        for (auto it = consumers.rbegin(); it != consumers.rend(); ++it)
+            detached = it->detach() && detached;
+
+        // Keep every guard if any protected callback could still run.
+        if (!detached)
+            return false;
+
+        for (auto it = guards.rbegin(); it != guards.rend(); ++it)
+            detached = it->detach() && detached;
+        return detached;
+    }
+};
+}
diff --git a/src/App/Extensions/Attachment/SlotQuery.hpp b/src/App/Extensions/Attachment/SlotQuery.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..a0fd729d699fef17608e3b3f1bad4a6374a5d278
--- /dev/null
+++ b/src/App/Extensions/Attachment/SlotQuery.hpp
@@ -0,0 +1,37 @@
+#pragma once
+
+#include "SlotScope.hpp"
+#include <RED4ext/Scripting/Natives/gameITransactionSystem.hpp>
+
+namespace App
+{
+struct AttachmentSlotState
+{
+    RED4ext::Handle<RED4ext::game::ItemObject> itemObject;
+    bool spawning = false;
+};
+
+inline AttachmentSlotState ReadAttachmentSlot(RED4ext::game::ITransactionSystem* aSystem,
+                                             RED4ext::IScriptable* aOwner, RED4ext::TweakDBID aSlotID)
+{
+    AttachmentSlotState result;
+    // Copy the owning handle inside the predicate, while the engine lock still
+    // protects the slot. FindSlotData's returned pointer outlives its read lock.
+    RED4ext::game::AttachmentSlotDataPredicate predicate = [&](const RED4ext::game::AttachmentSlotData& aSlot)
+    {
+        if (aSlot.slotID != aSlotID)
+            return false;
+
+        result.itemObject = aSlot.itemObject;
+        result.spawning = aSlot.spawningItemID.IsValid();
+        return true;
+    };
+
+    if (SlotLockScope::Owns(aOwner))
+        aSystem->FindSlotDataUnlocked(aOwner, std::move(predicate));
+    else
+        aSystem->FindSlotData(aOwner, std::move(predicate));
+
+    return result;
+}
+}
diff --git a/src/App/Extensions/Attachment/SlotScope.hpp b/src/App/Extensions/Attachment/SlotScope.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..6c37744959c05d4564b087030871546604bd1193
--- /dev/null
+++ b/src/App/Extensions/Attachment/SlotScope.hpp
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <utility>
+
+namespace App
+{
+// Enter only around a verified engine entry point whose callbacks run while
+// holding this component's slot lock. A lock byte alone cannot prove ownership.
+class SlotLockScope
+{
+public:
+    SlotLockScope(const void* aComponent, const void* aOwner) noexcept
+        : m_component(aComponent), m_owner(aOwner), m_previous(s_current)
+    {
+        s_current = this;
+    }
+
+    ~SlotLockScope() { s_current = m_previous; }
+    SlotLockScope(const SlotLockScope&) = delete;
+    SlotLockScope& operator=(const SlotLockScope&) = delete;
+
+    static bool Owns(const void* aOwner) noexcept
+    {
+        if (!aOwner)
+            return false;
+
+        for (auto scope = s_current; scope; scope = scope->m_previous)
+        {
+            if (scope->m_component && scope->m_owner == aOwner)
+                return true;
+        }
+        return false;
+    }
+
+    template<class TComponent, class TFunction, class... TArgs>
+    static decltype(auto) Invoke(TComponent* aComponent, TFunction aOriginal, TArgs&&... aArgs)
+    {
+        SlotLockScope scope(aComponent, aComponent ? aComponent->owner : nullptr);
+        return aOriginal(aComponent, std::forward<TArgs>(aArgs)...);
+    }
+
+private:
+    const void* m_component;
+    const void* m_owner;
+    const SlotLockScope* m_previous;
+    inline static thread_local const SlotLockScope* s_current = nullptr;
+};
+}
