new file mode 100644
index 0000000000000000000000000000000000000000..ede23434b23aa5142c5d2d64669bd3677e322e6c
--- /dev/null
+++ b/src/App/Extensions/PuppetState/ListenerRegistry.hpp
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <mutex>
+#include <utility>
+
+namespace App
+{
+// Serialize native registration/removal independently of state readers. The
+// engine's register/unregister routines do not call listeners; notifications
+// use a separate snapshot after releasing the listener-list lock.
+template<class TMap>
+class ListenerRegistry
+{
+public:
+    using Owner = typename TMap::key_type;
+    using Handler = typename TMap::mapped_type;
+
+    template<class TCreate, class TRegister>
+    void Attach(Owner aOwner, TCreate&& aCreate, TRegister&& aRegister)
+    {
+        std::lock_guard lifecycle(m_lifecycleMutex);
+        if (Find(aOwner))
+            return;
+
+        // Construction can query appearances and reenter state readers.
+        auto handler = aCreate();
+        {
+            std::lock_guard state(m_stateMutex);
+            m_handlers.insert({aOwner, handler});
+        }
+        aRegister(handler);
+    }
+
+    template<class TUnregister>
+    void Detach(Owner aOwner, TUnregister&& aUnregister)
+    {
+        std::lock_guard lifecycle(m_lifecycleMutex);
+        Handler handler;
+        {
+            std::lock_guard state(m_stateMutex);
+            auto it = m_handlers.find(aOwner);
+            if (it == m_handlers.end())
+                return;
+
+            handler = std::move(it.value());
+            m_handlers.erase(it);
+        }
+        // Own the listener across the native call, even after the map erases it.
+        aUnregister(handler);
+    }
+
+    Handler Find(Owner aOwner) const
+    {
+        std::lock_guard state(m_stateMutex);
+        auto it = m_handlers.find(aOwner);
+        return it == m_handlers.end() ? Handler{} : it.value();
+    }
+
+private:
+    TMap m_handlers;
+    std::mutex m_lifecycleMutex;
+    mutable std::mutex m_stateMutex;
+};
+}
