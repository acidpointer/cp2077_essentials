new file mode 100644
index 0000000000000000000000000000000000000000..15434718c5f77a4a8ad5b69de00abcbded257a8a
--- /dev/null
+++ b/src/common/SandboxIO.h
@@ -0,0 +1,35 @@
+#pragma once
+// Each mod owns its default streams. All filename operations pass through the
+// C++ path resolver; no process current directory or global io defaults change.
+inline constexpr const char* CETSandboxIOFactory = R"lua(
+return function(native, resolve)
+    local input = native.input()
+    local output = native.output()
+    local function open(path, mode) return native.open(resolve(path, true), mode or 'r') end
+    local function stream(value, mode)
+        if type(value) == 'string' then return assert(open(value, mode)) end
+        assert(native.type(value) == 'file', 'expected an open file or filename')
+        return value
+    end
+    return {
+        open = open,
+        type = native.type,
+        input = function(value)
+            if value ~= nil then input = stream(value, 'r') end
+            return input
+        end,
+        output = function(value)
+            if value ~= nil then output = stream(value, 'w') end
+            return output
+        end,
+        read = function(...) return input:read(...) end,
+        write = function(...) return output:write(...) end,
+        flush = function() return output:flush() end,
+        close = function(value) return native.close(value or output) end,
+        lines = function(path, ...)
+            if path == nil then return input:lines(...) end
+            return native.lines(resolve(path, false), ...)
+        end
+    }
+end
+)lua";
diff --git a/src/common/TaskQueue.h b/src/common/TaskQueue.h
new file mode 100644
index 0000000000000000000000000000000000000000..00587fd42eeb461bdc0d89fc0371f8b1d6e08002
--- /dev/null
+++ b/src/common/TaskQueue.h
@@ -0,0 +1,50 @@
+#pragma once
+#include <functional>
+#include <mutex>
+#include <vector>
+#include <utility>
+#include <exception>
+#include <iterator>
+
+// Callbacks never run under the queue mutex. Work added during Drain starts
+// on the next drain. Close invalidates a detached batch before merging it back.
+class CETTaskQueue
+{
+public:
+    void AddTask(const std::function<bool()>& task)
+    {
+        std::lock_guard lock(m_mutex);
+        if (!m_closed) m_tasks.push_back(task);
+    }
+    void Drain()
+    {
+        std::vector<std::function<bool()>> batch;
+        { std::lock_guard lock(m_mutex); if (m_closed || m_draining) return;
+          m_draining = true; batch.swap(m_tasks); }
+        std::vector<std::function<bool()>> repeated;
+        std::exception_ptr failure;
+        for (auto& task : batch)
+        {
+            { std::lock_guard lock(m_mutex); if (m_closed) break; }
+            try { if (!task()) repeated.push_back(std::move(task)); }
+            catch (...) { if (!failure) failure = std::current_exception(); repeated.push_back(std::move(task)); }
+        }
+        {
+        std::lock_guard lock(m_mutex);
+        m_draining = false;
+        if (!m_closed)
+            m_tasks.insert(m_tasks.begin(), std::make_move_iterator(repeated.begin()), std::make_move_iterator(repeated.end()));
+        }
+        if (failure) std::rethrow_exception(failure);
+    }
+    void Close()
+    {
+        std::vector<std::function<bool()>> retired;
+        { std::lock_guard lock(m_mutex); m_closed = true; retired.swap(m_tasks); }
+    }
+private:
+    std::mutex m_mutex;
+    std::vector<std::function<bool()>> m_tasks;
+    bool m_closed = false;
+    bool m_draining = false;
+};
