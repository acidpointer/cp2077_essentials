diff --git a/src/common/LuaLock.h b/src/common/LuaLock.h
new file mode 100644
index 0000000000000000000000000000000000000000..85affbb7a9ce4d5393444545277a3311880164aa
--- /dev/null
+++ b/src/common/LuaLock.h
@@ -0,0 +1,58 @@
+#pragma once
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <utility>
+
+// CET owns this implementation: never patch a downloaded TiltedCore header.
+namespace CETLua
+{
+template<class T, class M = std::recursive_mutex> struct Lockable;
+template<class T, class M = std::recursive_mutex> struct Locked
+{
+    using Data = typename Lockable<T, M>::Data;
+    explicit Locked(std::shared_ptr<Data> data) : m_data(std::move(data))
+    {
+        if (m_data) m_lock = std::unique_lock<M>(m_data->Mutex);
+    }
+    Locked(Locked&&) = default;
+    Locked& operator=(Locked&& other) noexcept
+    {
+        if (this != &other)
+        {
+            // The old shared owner may be the last one. Unlock before
+            // replacing it so unique_lock never touches a destroyed mutex.
+            m_lock = {};
+            m_data = std::move(other.m_data);
+            m_lock = std::move(other.m_lock);
+        }
+        return *this;
+    }
+    bool IsValid() const noexcept { return bool(m_data); }
+    T& Get() const
+    {
+        if (!m_data) throw std::runtime_error("Lua state has expired");
+        return m_data->Value;
+    }
+    operator typename Lockable<T, M>::Ref() const { return {m_data}; }
+    operator T&() const { return Get(); }
+private:
+    std::shared_ptr<Data> m_data;
+    std::unique_lock<M> m_lock;
+};
+template<class T, class M> struct Lockable
+{
+    struct Data { T Value; M Mutex; };
+    struct Ref
+    {
+        Ref(std::weak_ptr<Data> data) : m_data(std::move(data)) {}
+        Locked<T, M> Lock() const { return Locked<T, M>(m_data.lock()); }
+    private:
+        std::weak_ptr<Data> m_data;
+    };
+    Ref AsRef() const noexcept { return {m_data}; }
+    Locked<T, M> Lock() const { return AsRef().Lock(); }
+private:
+    std::shared_ptr<Data> m_data = std::make_shared<Data>();
+};
+}
diff --git a/src/common/MetadataReader.h b/src/common/MetadataReader.h
new file mode 100644
index 0000000000000000000000000000000000000000..99607a127aede9cbeed7bc605c14b6e7554b0362
--- /dev/null
+++ b/src/common/MetadataReader.h
@@ -0,0 +1,50 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <istream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+namespace Metadata
+{
+inline constexpr size_t MaxDecodedSize = 256 * 1024 * 1024;
+inline void CheckFileSize(uintmax_t size)
+{
+    if (size > MaxDecodedSize) throw std::runtime_error("Metadata file is too large");
+}
+inline uint32_t DecodedSize(const char* data, size_t size)
+{
+    if (size < 8 || std::memcmp(data, "KARK", 4)) throw std::runtime_error("Invalid KARK header");
+    uint32_t decoded; std::memcpy(&decoded, data + 4, sizeof(decoded));
+    if (!decoded || decoded > MaxDecodedSize || size - 8 > size_t(std::numeric_limits<int>::max()))
+        throw std::runtime_error("KARK size is outside supported bounds");
+    return decoded;
+}
+inline uint8_t Byte(std::istream& input)
+{
+    char value;
+    if (!input.get(value)) throw std::runtime_error("Truncated metadata integer");
+    return static_cast<uint8_t>(value);
+}
+inline int32_t Length(std::istream& input)
+{
+    auto byte = Byte(input);
+    // Unreal-style packed signed int: names are required to be nonnegative.
+    if (byte & 0x80) throw std::runtime_error("Negative metadata string length");
+    uint32_t value = byte & 0x3f;
+    if (byte & 0x40)
+    {
+        for (unsigned shift = 6; shift <= 27; shift += 7)
+        {
+            byte = Byte(input);
+            if (shift == 27 && (byte & 0xf0)) throw std::runtime_error("Metadata integer overflow");
+            value |= uint32_t(byte & 0x7f) << shift;
+            if (!(byte & 0x80)) break;
+        }
+    }
+    if (value > MaxDecodedSize) throw std::runtime_error("Metadata string is too large");
+    return static_cast<int32_t>(value);
+}
+inline void Count(uint32_t count) { if (count > 8 * 1024 * 1024) throw std::runtime_error("Metadata count is too large"); }
+}
diff --git a/src/common/Runtime.cpp b/src/common/Runtime.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cde90864f6e3492bd8cd3aa3f34290c6dc043e95
--- /dev/null
+++ b/src/common/Runtime.cpp
@@ -0,0 +1,107 @@
+#include "Runtime.h"
+#include <stdexcept>
+#include <string>
+
+#include <thread>
+namespace
+{
+std::mutex gate;
+std::condition_variable idle;
+bool accepting = false;
+bool stopRequested = false;
+bool finalizing = false;
+bool finished = false;
+size_t callbacks = 0;
+thread_local size_t depth = 0;
+std::thread::id finalizerThread;
+std::function<void()> stopAction;
+std::vector<void*> locations;
+std::atomic_uint64_t luaGeneration{0};
+
+std::function<void()> TakeFinalizer()
+{
+    if (callbacks || finalizing || finished || !stopRequested) return {};
+    finalizing = true;
+    finalizerThread = std::this_thread::get_id();
+    return std::move(stopAction);
+}
+void Finish(std::function<void()> action) noexcept
+{
+    try { if (action) action(); }
+    catch (...) { OutputDebugStringA("CET shutdown incomplete; resident state retained\n"); }
+    { std::lock_guard lock(gate); finished = true; finalizing = false; finalizerThread = {}; }
+    idle.notify_all();
+}
+}
+Runtime::Callback::Callback()
+{
+    std::lock_guard lock(gate);
+    if ((m_entered = accepting)) { ++callbacks; ++depth; }
+}
+Runtime::Callback::~Callback()
+{
+    if (!m_entered) return;
+    std::function<void()> finalize;
+    bool claimed = false;
+    { std::lock_guard lock(gate);
+      --depth;
+      if (--callbacks == 0)
+      {
+          claimed = stopRequested && !finalizing && !finished;
+          finalize = TakeFinalizer();
+          idle.notify_all();
+      } }
+    if (claimed) Finish(std::move(finalize));
+}
+void Runtime::Start()
+{
+    std::lock_guard lock(gate);
+    if (callbacks || finalizing) throw std::runtime_error("CET callbacks have not stopped");
+    stopRequested = finished = false; accepting = true;
+}
+bool Runtime::Running() noexcept { std::lock_guard lock(gate); return accepting; }
+void Runtime::Stop(std::function<void()> finalize)
+{
+    std::unique_lock lock(gate);
+    accepting = false;
+    if (!stopRequested) { stopRequested = true; stopAction = std::move(finalize); }
+    if (depth || finalizerThread == std::this_thread::get_id()) return;
+    idle.wait(lock, [] { return finished || (!callbacks && !finalizing); });
+    if (finished) return;
+    auto action = TakeFinalizer();
+    lock.unlock();
+    Finish(std::move(action));
+}
+void Hooks::Begin()
+{
+    const auto status = MH_Initialize();
+    if (status != MH_OK) throw std::runtime_error(MH_StatusToString(status));
+}
+MH_STATUS Hooks::Create(void* target, void* detour, void** original)
+{
+    const auto status = MH_CreateHook(target, detour, original);
+    if (status != MH_OK) throw std::runtime_error(std::string("CET hook creation: ") + MH_StatusToString(status));
+    try { locations.push_back(target); }
+    catch (...) { MH_RemoveHook(target); throw; }
+    return status;
+}
+MH_STATUS Hooks::Enable(void* target)
+{
+    const auto status = MH_QueueEnableHook(target);
+    if (status != MH_OK) throw std::runtime_error(std::string("CET hook queue: ") + MH_StatusToString(status));
+    return status;
+}
+void Hooks::Commit()
+{
+    const auto status = MH_ApplyQueued();
+    if (status != MH_OK) { Disable(); throw std::runtime_error(MH_StatusToString(status)); }
+}
+void Hooks::Disable() noexcept
+{
+    for (auto* target : locations) MH_DisableHook(target);
+    // Never free a gateway while a thread might still be returning through it.
+    // The DLL and this instance's gateways are process-lifetime allocations.
+}
+
+uint64_t Runtime::LuaGeneration() noexcept { return luaGeneration.load(); }
+void Runtime::AdvanceLuaGeneration() noexcept { ++luaGeneration; }
