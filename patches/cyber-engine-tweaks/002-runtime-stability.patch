diff --git a/src/common/CallAllocator.h b/src/common/CallAllocator.h
new file mode 100644
index 0000000000000000000000000000000000000000..7d8be8e2aa43a607ef719b385ae64bda8daec195
--- /dev/null
+++ b/src/common/CallAllocator.h
@@ -0,0 +1,39 @@
+#pragma once
+#include <TiltedCore/Allocator.hpp>
+#include <memory_resource>
+#include <limits>
+
+// A conversion can reenter through Lua tostring/native callbacks. Each call
+// owns its arena; resetting a thread-local arena would invalidate its caller.
+class CallAllocator final : public TiltedPhoques::Allocator
+{
+public:
+    void* Allocate(size_t size) noexcept override
+    {
+        if (size > Limit - m_bytes) return nullptr;
+        try
+        {
+            auto* result = m_memory.allocate(size, 16);
+            m_bytes += size;
+            return result;
+        }
+        catch (...) { return nullptr; }
+    }
+    void Free(void*) noexcept override {}
+    size_t Size(void*) noexcept override { return m_bytes; }
+private:
+    static constexpr size_t Limit = 64 * 1024 * 1024;
+    size_t m_bytes = 0;
+    std::pmr::monotonic_buffer_resource m_memory{4096};
+};
+class ScopedAllocator
+{
+public:
+    explicit ScopedAllocator(TiltedPhoques::Allocator* current) : m_old(TiltedPhoques::Allocator::Get()) { TiltedPhoques::Allocator::Set(current); }
+    ~ScopedAllocator() { Restore(); }
+    void Restore() { if (m_active) { TiltedPhoques::Allocator::Set(m_old); m_active = false; } }
+    ScopedAllocator(const ScopedAllocator&) = delete;
+private:
+    TiltedPhoques::Allocator* m_old;
+    bool m_active = true;
+};
diff --git a/src/common/D3DUpload.cpp b/src/common/D3DUpload.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3f850a077784e9575e5dd144d463ed7c582663c1
--- /dev/null
+++ b/src/common/D3DUpload.cpp
@@ -0,0 +1,98 @@
+#include "D3DUpload.h"
+#include <list>
+#include <mutex>
+#include <memory>
+#include <cstring>
+namespace
+{
+struct UploadState
+{
+    Microsoft::WRL::ComPtr<ID3D12CommandQueue> Queue;
+    Microsoft::WRL::ComPtr<ID3D12Resource> Texture, Buffer;
+    Microsoft::WRL::ComPtr<ID3D12CommandAllocator> Allocator;
+    Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList> List;
+    Microsoft::WRL::ComPtr<ID3D12Fence> Fence;
+    ID3D12Device* Device = nullptr;
+    bool Failed = false;
+};
+// A failed signal/timeout is not proof that the GPU has stopped using memory.
+// Reserve ownership before submission; retain every failed in-flight upload.
+std::mutex failedMutex;
+auto& PendingUploads() { static auto* pending = new std::list<std::shared_ptr<UploadState>>; return *pending; }
+}
+bool Graphics::Wait(ID3D12Fence* fence, uint64_t value, DWORD timeout)
+{
+    if (!fence || !value) return true;
+    const auto completed = fence->GetCompletedValue();
+    if (completed == UINT64_MAX) return false;
+    if (completed >= value) return true;
+    HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    if (!event) return false;
+    const auto status = fence->SetEventOnCompletion(value, event);
+    const auto result = SUCCEEDED(status) ? WaitForSingleObject(event, timeout) : WAIT_FAILED;
+    // A registered but unsignaled event must remain valid for the driver.
+    // Failed callers retain the fence/resources for the process lifetime.
+    if (FAILED(status) || result == WAIT_OBJECT_0) CloseHandle(event);
+    return result == WAIT_OBJECT_0 && fence->GetCompletedValue() != UINT64_MAX;
+}
+Microsoft::WRL::ComPtr<ID3D12Resource> Graphics::Upload(ID3D12Device* device, ID3D12CommandQueue* queue,
+                                                     const unsigned char* pixels, int width, int height)
+{
+    if (!device || !pixels || width <= 0 || height <= 0 || width > 16384 || height > 16384)
+        throw std::runtime_error("Unsupported texture dimensions");
+    const uint64_t pitch = (uint64_t(width) * 4 + 255) & ~uint64_t(255);
+    const uint64_t size = pitch * uint64_t(height);
+    if (size > 256 * 1024 * 1024) throw std::runtime_error("Texture upload is too large");
+    { std::lock_guard lock(failedMutex);
+      for (const auto& upload : PendingUploads())
+          if (upload->Device == device && upload->Failed) throw std::runtime_error("Texture uploads stopped after a GPU failure"); }
+    auto state = std::make_shared<UploadState>();
+    state->Device = device;
+    D3D12_HEAP_PROPERTIES heap{}; heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width; desc.Height = height; desc.DepthOrArraySize = 1; desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM; desc.SampleDesc.Count = 1;
+    Check(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&state->Texture)));
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; desc.Width = size; desc.Height = 1;
+    desc.Format = DXGI_FORMAT_UNKNOWN; desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    heap.Type = D3D12_HEAP_TYPE_UPLOAD;
+    Check(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_GENERIC_READ, nullptr, IID_PPV_ARGS(&state->Buffer)));
+    void* mapped = nullptr; D3D12_RANGE readRange{0, 0};
+    Check(state->Buffer->Map(0, &readRange, &mapped));
+    for (int row = 0; row < height; ++row)
+        std::memcpy(static_cast<char*>(mapped) + row * pitch, pixels + size_t(row) * width * 4, size_t(width) * 4);
+    state->Buffer->Unmap(0, nullptr);
+    state->Queue = queue;
+    if (!state->Queue)
+    {
+        D3D12_COMMAND_QUEUE_DESC config{}; config.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+        Check(device->CreateCommandQueue(&config, IID_PPV_ARGS(&state->Queue)));
+    }
+    Check(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&state->Allocator)));
+    Check(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, state->Allocator.Get(), nullptr, IID_PPV_ARGS(&state->List)));
+    D3D12_TEXTURE_COPY_LOCATION source{}; source.pResource = state->Buffer.Get();
+    source.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    source.PlacedFootprint.Footprint = {DXGI_FORMAT_R8G8B8A8_UNORM, UINT(width), UINT(height), 1, UINT(pitch)};
+    D3D12_TEXTURE_COPY_LOCATION destination{}; destination.pResource = state->Texture.Get();
+    destination.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    state->List->CopyTextureRegion(&destination, 0, 0, 0, &source, nullptr);
+    D3D12_RESOURCE_BARRIER barrier{}; barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition = {state->Texture.Get(), D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE};
+    state->List->ResourceBarrier(1, &barrier);
+    Check(state->List->Close());
+    Check(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&state->Fence)));
+    ID3D12CommandList* lists[] = {state->List.Get()};
+    std::list<std::shared_ptr<UploadState>>::iterator retained;
+    { std::lock_guard lock(failedMutex); retained = PendingUploads().insert(PendingUploads().end(), state); }
+    state->Queue->ExecuteCommandLists(1, lists);
+    const auto signaled = state->Queue->Signal(state->Fence.Get(), 1);
+    if (FAILED(signaled) || !Wait(state->Fence.Get(), 1))
+    {
+        std::lock_guard lock(failedMutex);
+        state->Failed = true;
+        throw std::runtime_error("Texture upload did not complete; retaining GPU resources");
+    }
+    { std::lock_guard lock(failedMutex); PendingUploads().erase(retained); }
+    return state->Texture;
+}
