diff --git a/src/reverse/NativeValue.h b/src/reverse/NativeValue.h
new file mode 100644
index 0000000000000000000000000000000000000000..712610fec815be7a36cb96e70a8649cb319a9237
--- /dev/null
+++ b/src/reverse/NativeValue.h
@@ -0,0 +1,26 @@
+#pragma once
+// Owning, RTTI-constructed snapshot. Keep it alive across any engine mutation
+// that can relocate the flat buffer. No borrowed engine pointer escapes a read lock.
+struct NativeValue : RED4ext::CStackType
+{
+    std::shared_ptr<void> Owner;
+    NativeValue() = default;
+    explicit NativeValue(RED4ext::rtti::IType* aType)
+    {
+        if (!aType) return;
+        type = aType;
+        auto* allocator = type->GetAllocator();
+        void* memory = allocator->AllocAligned(type->GetSize(), type->GetAlignment()).memory;
+        if (!memory) throw std::bad_alloc();
+        try { type->Construct(memory); }
+        catch (...) { allocator->Free(memory); throw; }
+        Owner = std::shared_ptr<void>(memory, [rtti = type, allocator](void* data) { rtti->Destruct(data); allocator->Free(data); });
+        value = memory;
+    }
+    explicit NativeValue(const RED4ext::CStackType& source)
+    {
+        if (!source.type || !source.value) return;
+        *this = NativeValue(source.type);
+        type->Assign(value, source.value);
+    }
+};
