diff --git a/src/common/JsonConfig.cpp b/src/common/JsonConfig.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9ce28c5868346d0131aa4344b6d24c86c94ebf60
--- /dev/null
+++ b/src/common/JsonConfig.cpp
@@ -0,0 +1,58 @@
+#include <Windows.h>
+#include <spdlog/spdlog.h>
+#include <algorithm>
+#include "JsonConfig.h"
+
+bool Config::Write(const std::filesystem::path& path, const nlohmann::json& value, bool preserveInvalid) noexcept
+{
+    HANDLE file = INVALID_HANDLE_VALUE;
+    std::filesystem::path temporary;
+    try
+    {
+        if (path.empty()) throw std::runtime_error("Empty configuration path");
+        const auto bytes = value.dump(4) + "\n";
+        static std::atomic_uint64_t sequence{0};
+        temporary = path;
+        temporary += L".tmp-" + std::to_wstring(GetCurrentProcessId()) + L"-" + std::to_wstring(++sequence);
+        file = CreateFileW(temporary.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file == INVALID_HANDLE_VALUE) throw std::runtime_error("Cannot create configuration temporary file");
+        size_t offset = 0;
+        while (offset < bytes.size())
+        {
+            DWORD written = 0;
+            auto chunk = static_cast<DWORD>(std::min(bytes.size() - offset, size_t(1 << 20)));
+            if (!WriteFile(file, bytes.data() + offset, chunk, &written, nullptr) || !written)
+                throw std::runtime_error("Cannot write configuration temporary file");
+            offset += written;
+        }
+        if (!FlushFileBuffers(file)) throw std::runtime_error("Cannot flush configuration temporary file");
+        CloseHandle(file); file = INVALID_HANDLE_VALUE;
+        if (std::filesystem::exists(path))
+        {
+            if (preserveInvalid)
+            {
+                bool preserved = false;
+                for (unsigned i = 1; i <= 4096; ++i)
+                {
+                    auto invalid = path; invalid += L".invalid-" + std::to_wstring(i);
+                    if (CopyFileW(path.c_str(), invalid.c_str(), TRUE)) { preserved = true; break; }
+                    if (GetLastError() != ERROR_FILE_EXISTS && GetLastError() != ERROR_ALREADY_EXISTS) break;
+                }
+                if (!preserved) throw std::runtime_error("Cannot preserve invalid configuration");
+            }
+            auto backup = path; backup += L".bak";
+            // Keep the previous file for recovery, including malformed user input.
+            if (!CopyFileW(path.c_str(), backup.c_str(), FALSE)) throw std::runtime_error("Cannot preserve previous configuration");
+        }
+        if (!MoveFileExW(temporary.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+            throw std::runtime_error("Cannot replace configuration");
+        return true;
+    }
+    catch (const std::exception& error)
+    {
+        if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+        if (!temporary.empty()) DeleteFileW(temporary.c_str());
+        spdlog::error("CET configuration save failed: {}", error.what());
+        return false;
+    }
+}
diff --git a/src/common/JsonConfig.h b/src/common/JsonConfig.h
new file mode 100644
index 0000000000000000000000000000000000000000..91dc70e189218cb4a10fe250e6e72741b24c817e
--- /dev/null
+++ b/src/common/JsonConfig.h
@@ -0,0 +1,75 @@
+#pragma once
+#include <nlohmann/json.hpp>
+#include <filesystem>
+#include <fstream>
+#include <atomic>
+#include <limits>
+#include <stdexcept>
+#include <type_traits>
+namespace Config
+{
+inline thread_local bool HadInvalidValue = false;
+inline void Invalid() noexcept { HadInvalidValue = true; }
+template<class T> T Value(const nlohmann::json& object, const char* key, const T& fallback)
+{
+    if (!object.is_object()) { Invalid(); return fallback; }
+    auto it = object.find(key);
+    if (it == object.end()) return fallback;
+    if constexpr (std::is_same_v<T, bool>) { if (!it->is_boolean()) { Invalid(); return fallback; } }
+    if constexpr (std::is_arithmetic_v<T> && !std::is_same_v<T, bool>)
+    {
+        if (!it->is_number()) { Invalid(); return fallback; }
+        if constexpr (std::is_integral_v<T>)
+        {
+            if (!it->is_number_integer()) { Invalid(); return fallback; }
+            auto value = it->template get<long double>();
+            if (value < std::numeric_limits<T>::lowest() || value > std::numeric_limits<T>::max()) { Invalid(); return fallback; }
+        }
+    }
+    try { return it->template get<T>(); } catch (const nlohmann::json::exception&) { Invalid(); return fallback; }
+}
+inline const nlohmann::json& Node(const nlohmann::json& object, const char* key)
+{
+    static const nlohmann::json empty = nlohmann::json::object();
+    if (!object.is_object()) { Invalid(); return empty; }
+    const auto it = object.find(key);
+    if (it == object.end()) return empty;
+    if (!it->is_object()) { Invalid(); return empty; }
+    return *it;
+}
+inline nlohmann::json Read(const std::filesystem::path& path)
+{
+    std::error_code error;
+    const auto size = std::filesystem::file_size(path, error);
+    if (error == std::errc::no_such_file_or_directory) return nlohmann::json::object();
+    if (error || size > 8 * 1024 * 1024) { Invalid(); return nlohmann::json::object(); }
+    std::ifstream input(path);
+    auto value = input ? nlohmann::json::parse(input, nullptr, false) : nlohmann::json();
+    if (!value.is_object()) { Invalid(); return nlohmann::json::object(); }
+    return value;
+}
+template<class Insert> void Bindings(const nlohmann::json& config, Insert insert)
+{
+    if (!config.is_object()) { Invalid(); return; }
+    auto number = [](const nlohmann::json& value) { return value.is_number_unsigned() || (value.is_number_integer() && value.template get<int64_t>() >= 0); };
+    for (const auto& mod : config.items())
+    {
+        if (mod.value().is_object())
+        {
+            for (const auto& bind : mod.value().items())
+                if (number(bind.value())) insert(mod.key(), bind.key(), bind.value().template get<uint64_t>());
+                else Invalid();
+        }
+        else if (number(mod.value()))
+        {
+            const auto split = mod.key().find('.');
+            if (split != std::string::npos && split && split+1 < mod.key().size())
+                insert(mod.key().substr(0,split), mod.key().substr(split+1), mod.value().template get<uint64_t>());
+            else Invalid();
+        }
+        else Invalid();
+    }
+}
+// Defined out-of-line so portable schema tests don't require Windows headers.
+bool Write(const std::filesystem::path& path, const nlohmann::json& value, bool preserveInvalid = false) noexcept;
+}
diff --git a/src/common/LuaJitFile.c b/src/common/LuaJitFile.c
new file mode 100644
index 0000000000000000000000000000000000000000..de4da37e8bf5b08af61d39a0637229363163252c
--- /dev/null
+++ b/src/common/LuaJitFile.c
@@ -0,0 +1,70 @@
+#include "LuaJitFile.h"
+#undef fopen
+#undef remove
+#undef rename
+#undef LoadLibraryExA
+#include <Windows.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <wchar.h>
+
+static wchar_t* wide(const char* text)
+{
+    if (!text || !*text) { errno = EINVAL; return NULL; }
+    const int size = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text, -1, NULL, 0);
+    if (!size) { errno = EILSEQ; return NULL; }
+    wchar_t* result = (wchar_t*)malloc((size_t)size * sizeof(wchar_t));
+    if (!result) { errno = ENOMEM; return NULL; }
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text, -1, result, size))
+    { free(result); errno = EILSEQ; return NULL; }
+    return result;
+}
+static int valid_mode(const char* mode)
+{
+    if (!mode || !strchr("rwa", mode[0]) || !mode[0]) return 0;
+    int plus = 0, encoding = 0, exclusive = 0;
+    for (const char* next = mode + 1; *next; ++next)
+    {
+        if (*next == '+') { if (plus++) return 0; }
+        else if (*next == 'b' || *next == 't') { if (encoding++) return 0; }
+        else if (*next == 'x' && mode[0] == 'w' && !next[1]) { if (exclusive++) return 0; }
+        else return 0;
+    }
+    return 1;
+}
+FILE* cet_luajit_fopen_utf8(const char* path, const char* mode)
+{
+    if (!valid_mode(mode)) { errno = EINVAL; return NULL; }
+    wchar_t* name = wide(path);
+    if (!name) return NULL;
+    wchar_t* options = wide(mode);
+    if (!options) { free(name); return NULL; }
+    FILE* file = _wfopen(name, options);
+    int error = errno;
+    free(options); free(name); errno = error;
+    return file;
+}
+int cet_luajit_remove_utf8(const char* path)
+{
+    wchar_t* name = wide(path);
+    if (!name) return -1;
+    int result = _wremove(name), error = errno;
+    free(name); errno = error; return result;
+}
+int cet_luajit_rename_utf8(const char* old_path, const char* new_path)
+{
+    wchar_t* old_name = wide(old_path);
+    if (!old_name) return -1;
+    wchar_t* new_name = wide(new_path);
+    if (!new_name) { free(old_name); return -1; }
+    int result = _wrename(old_name, new_name), error = errno;
+    free(old_name); free(new_name); errno = error; return result;
+}
+void* __stdcall cet_luajit_load_utf8(const char* path, void* file, unsigned long flags)
+{
+    wchar_t* name = wide(path);
+    if (!name) { SetLastError(ERROR_NO_UNICODE_TRANSLATION); return NULL; }
+    HMODULE module = LoadLibraryExW(name, file, flags);
+    DWORD error = GetLastError(); free(name); SetLastError(error); return module;
+}
