@@ -0,0 +1,65 @@
+#pragma once
+
+#include <RED4ext/RED4ext.hpp>
+
+// Mod Settings' native configuration interface, adapted from Jack Humbert's
+// MIT-licensed RED4ext.SDK fork b5ea5919 userRuntimeSettingsVar.hpp.
+// This is plugin-owned; do not add private declarations to the shared SDK.
+namespace ModSettings::Native {
+struct ConfigVarFlags {
+  uint32_t isInPreGame : 1;
+  uint32_t isInGame : 1;
+  uint32_t isVisible : 1;
+  uint32_t isPlatformSpecific : 1;
+  uint32_t isDynamic : 1;
+  uint32_t unk20 : 1;
+  uint32_t isInitialized : 1;
+  uint32_t listHasDisplayValues : 1;
+  uint32_t canBeRestoredToDefault : 1;
+  uint32_t isInput : 1;
+  uint32_t unk400 : 1; // additional retail flag
+  uint32_t isDisabled : 1; // 0x800 in 2.5
+};
+enum class EConfigVarType : uint8_t { Bool, Int, Float, Name, IntList, FloatList, StringList, NameList };
+enum class EConfigVarUpdatePolicy : uint8_t { Disabled, Immediately, ConfirmationRequired, RestartRequired, LoadLastCheckpointRequired };
+enum class EConfigVarImportPolicy : uint8_t { ReadValue, Ignore };
+
+// Retail accessors consume this prefix through userSettingsVar::runtimeVar
+// (+0x40). Derived Mod Settings values use their own methods and layout.
+#pragma pack(push, 1)
+struct RuntimeSettingsVar {
+  virtual RED4ext::Memory::IAllocator* GetAllocator(RuntimeSettingsVar*) {
+    return RED4ext::Memory::DefaultAllocator::Get();
+  }
+  virtual RuntimeSettingsVar* Deinitialize(bool) { displayNameKeys.Clear(); return this; }
+  virtual bool WasModifiedSinceLastSave() = 0;
+  virtual bool HasChange() = 0;
+  virtual bool IsDefault() = 0;
+  virtual bool RestoreDefault(uint8_t) = 0;
+  virtual void SetRequestedValue(void*) = 0;
+  virtual void AcceptChange() = 0;
+  virtual void RejectChange() = 0;
+  virtual void MarkAsSaved() = 0;
+  virtual void LoadValue(void*) = 0;
+
+  RED4ext::CName name{};                 // 08
+  RED4ext::CName groupPath{};            // 10
+  RED4ext::CName displayName{};          // 18
+  RED4ext::DynArray<RED4ext::CName> displayNameKeys; // 20
+  RED4ext::CName description{};          // 30
+  RED4ext::CName warning{};              // 38 (2.3+)
+  EConfigVarType type{};                // 40
+  EConfigVarUpdatePolicy updatePolicy = EConfigVarUpdatePolicy::Immediately;
+  EConfigVarImportPolicy importPolicy = EConfigVarImportPolicy::ReadValue;
+  uint8_t unk43{};
+  ConfigVarFlags bitfield{};            // 44
+  uint32_t order{};                     // 48
+  uint8_t unk44 = 0xFF;                 // 4C
+  uint8_t unk45 = 0xFF;                 // 4D
+  uint8_t unk46{};
+  uint8_t unk47{};
+  uint32_t unk50_new{};
+};
+#pragma pack(pop)
+static_assert(sizeof(RuntimeSettingsVar) == 0x54);
+}
diff --git a/src/red4ext/Registrar.hpp b/src/red4ext/Registrar.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..1e56d17eb830d75c6fa40bf15d3beb3ce85a6229
--- /dev/null
+++ b/src/red4ext/Registrar.hpp
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <RED4ext/RED4ext.hpp>
+#include <vector>
+
+// Resolve only during Main(Load), after RED4ext initializes the address resolver.
+// Fail a missing/failed hook once, rolling back every earlier attachment.
+class ModModuleHookHash;
+class ModModuleFactory {
+public:
+  static ModModuleFactory& GetInstance() { static ModModuleFactory value; return value; }
+  void registerHook(ModModuleHookHash* hook) { hooks.push_back(hook); }
+  bool Load(const RED4ext::v1::Sdk*, RED4ext::v1::PluginHandle);
+  void Unload(const RED4ext::v1::Sdk*, RED4ext::v1::PluginHandle);
+private:
+  std::vector<ModModuleHookHash*> hooks;
+};
+
+class ModModuleHookHash {
+public:
+  ModModuleHookHash(const char* name, uint32_t hash, void* detour, void** original)
+      : name(name), hash(hash), detour(detour), original(original) {
+    ModModuleFactory::GetInstance().registerHook(this);
+  }
+  const char* name;
+  uint32_t hash;
+  void* detour;
+  void** original;
+  void* target = nullptr;
+  bool attached = false;
+};
+
+inline void ModModuleFactory::Unload(const RED4ext::v1::Sdk* sdk, RED4ext::v1::PluginHandle handle) {
+  for (auto it = hooks.rbegin(); it != hooks.rend(); ++it) {
+    auto hook = *it;
+    if (hook->attached && sdk->hooking->Detach(handle, hook->target)) hook->attached = false;
+  }
+}
+
+inline bool ModModuleFactory::Load(const RED4ext::v1::Sdk* sdk, RED4ext::v1::PluginHandle handle) {
+  for (auto hook : hooks) {
+    hook->target = reinterpret_cast<void*>(RED4ext::UniversalRelocBase::Resolve(hook->hash));
+    if (!hook->target || !sdk->hooking->Attach(handle, hook->target, hook->detour, hook->original)) {
+      sdk->logger->ErrorF(handle, "Failed to attach %s (hash %u)", hook->name, hook->hash);
+      Unload(sdk, handle);
+      return false;
+    }
+    hook->attached = true;
+  }
+  return true;
+}
+
+#define REGISTER_HOOK_HASH(retType, hash, func, ...) \
+  retType func(__VA_ARGS__); \
+  inline decltype(&func) func##_Original; \
+  ModModuleHookHash s_##func##_Hook(#func, hash, reinterpret_cast<void*>(&func), reinterpret_cast<void**>(&func##_Original)); \
+  retType func(__VA_ARGS__)
