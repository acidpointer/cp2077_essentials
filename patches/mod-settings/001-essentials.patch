-inline RED4ext::CBaseRTTIType* ToType(const RED4ext::CName name) {
+static void RedTypeFromString(T* pointer, const RED4ext::CString& str) {
+  const char* name = nullptr;
+  if constexpr (std::is_same_v<T, bool>) name = "Bool";
+  else if constexpr (std::is_same_v<T, int8_t>) name = "Int8";
+  else if constexpr (std::is_same_v<T, int16_t>) name = "Int16";
+  else if constexpr (std::is_same_v<T, int32_t>) name = "Int32";
+  else if constexpr (std::is_same_v<T, int64_t>) name = "Int64";
+  else if constexpr (std::is_same_v<T, uint8_t>) name = "Uint8";
+  else if constexpr (std::is_same_v<T, uint16_t>) name = "Uint16";
+  else if constexpr (std::is_same_v<T, uint32_t>) name = "Uint32";
+  else if constexpr (std::is_same_v<T, uint64_t>) name = "Uint64";
+  else if constexpr (std::is_same_v<T, float>) name = "Float";
+  else if constexpr (std::is_same_v<T, double>) name = "Double";
+  else if constexpr (std::is_same_v<T, RED4ext::CName>) {
+    *pointer = RED4ext::CNamePool::Add(str.c_str());
+    return;
+  } else if constexpr (std::is_same_v<T, RED4ext::EInputKey>) name = "EInputKey";
+  if (name) {
+    if (auto type = RED4ext::CRTTISystem::Get()->GetType(name)) type->FromString(pointer, str);
+  }
+}
