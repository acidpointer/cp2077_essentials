+#include "stdafx.hpp"
+#include "Hooks/ApplyOverrides.hpp"
+#include "ModConfigVar.hpp"
+#include "NativeSettings.hpp"
+#include "ScriptData.hpp"
+#include "ScriptDefinitions/ScriptProperty.hpp"
+
+// The SDK's offset macro is disabled under Clang. These retail boundaries must
+// still be checked by the compiler for every Mod Settings build.
+#if defined(__clang__)
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Winvalid-offsetof"
+#endif
+static_assert(sizeof(RED4ext::Callback<void(*)()>) == 0x48);
+static_assert(offsetof(ModSettings::ScriptData, classes) == 0xD8);
+static_assert(offsetof(ModSettings::ScriptClass, properties) == 0x50);
+static_assert(offsetof(ModSettings::ScriptClass, functions) == 0x90);
+static_assert(offsetof(ModSettings::ScriptProperty, parent) == 0x48);
+static_assert(offsetof(ModSettings::ScriptProperty, defaultValues) == 0x68);
+static_assert(offsetof(ModSettings::ScriptProperty, runtimeProperties) == 0x88);
+static_assert(offsetof(ModSettings::ScriptProperty, type) == 0xB8);
+static_assert(offsetof(ModConfigVar<bool>, runtimeVar) == 0x40);
+static_assert(offsetof(ModConfigVarRange<float>, runtimeVar) == 0x40);
+static_assert(offsetof(ModConfigVarEnum, runtimeVar) == 0x40);
+static_assert(offsetof(ModSettings::Native::RuntimeSettingsVar, displayName) == 0x18);
+static_assert(offsetof(ModSettings::Native::RuntimeSettingsVar, description) == 0x30);
+static_assert(offsetof(ModSettings::Native::RuntimeSettingsVar, type) == 0x40);
+static_assert(offsetof(ModSettings::Native::RuntimeSettingsVar, bitfield) == 0x44);
+static_assert(offsetof(ModSettings::Native::RuntimeSettingsVar, order) == 0x48);
+static_assert(offsetof(Manager, contextManager) == 0x10);
+static_assert(offsetof(ContextManager, userMapping) == 0x08);
+static_assert(offsetof(ContextManager, actions) == 0x28);
+static_assert(offsetof(ContextManager::ActionData, mapNames) == 0x08);
+static_assert(offsetof(UserMapping, rawMappings) == 0xA0);
+static_assert(offsetof(UserMapping::Mapping, key16) == 0x02);
+static_assert(offsetof(UserMapping::Mapping, overridableUI) == 0x34);
+static_assert(sizeof(UserMapping::Mapping) == 0x40);
+static_assert(offsetof(UserMapping::RawMappingCollection, needs_update) == 0x10);
+#if defined(__clang__)
+#pragma clang diagnostic pop
+#endif
