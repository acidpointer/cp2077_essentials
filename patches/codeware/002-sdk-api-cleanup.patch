diff --git a/src/App/Utils/Unicode.hpp b/src/App/Utils/Unicode.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..250092d70d5547b156ec9f88856762134c3caa0c
--- /dev/null
+++ b/src/App/Utils/Unicode.hpp
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <Windows.h>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+
+namespace App
+{
+inline std::wstring UTF8ToWide(std::string_view aText)
+{
+    if (aText.empty())
+        return {};
+    if (aText.size() > static_cast<size_t>((std::numeric_limits<int>::max)()))
+        throw std::length_error("UTF-8 input is too long");
+
+    const auto length = static_cast<int>(aText.size());
+    const auto size = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, aText.data(), length, nullptr, 0);
+    if (size == 0)
+        throw std::range_error("Invalid UTF-8 input");
+    std::wstring result(size, L'\0');
+    if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, aText.data(), length, result.data(), size) != size)
+        throw std::range_error("UTF-8 conversion failed");
+    return result;
+}
+
+inline std::string WideToUTF8(std::wstring_view aText)
+{
+    if (aText.empty())
+        return {};
+    if (aText.size() > static_cast<size_t>((std::numeric_limits<int>::max)()))
+        throw std::length_error("UTF-16 input is too long");
+
+    const auto length = static_cast<int>(aText.size());
+    const auto size = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, aText.data(), length, nullptr, 0, nullptr, nullptr);
+    if (size == 0)
+        throw std::range_error("Invalid UTF-16 input");
+    std::string result(size, '\0');
+    if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, aText.data(), length, result.data(), size, nullptr, nullptr) != size)
+        throw std::range_error("UTF-16 conversion failed");
+    return result;
+}
+}
