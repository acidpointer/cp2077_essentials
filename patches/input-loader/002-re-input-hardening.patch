diff --git a/src/Merge.hpp b/src/Merge.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..8f711c1652ae8e0e54e388fbb552c62cf3ae5be9
--- /dev/null
+++ b/src/Merge.hpp
@@ -0,0 +1,84 @@
+#pragma once
+
+#include <algorithm>
+#include <cwctype>
+#include <filesystem>
+#include <string_view>
+#include <pugixml.hpp>
+
+namespace InputLoader {
+
+inline bool IsInputFile(const std::filesystem::directory_entry &entry) {
+  std::error_code error;
+  if (!entry.is_regular_file(error) || error)
+    return false;
+  auto extension = entry.path().extension().wstring();
+  std::transform(extension.begin(), extension.end(), extension.begin(),
+                 [](wchar_t ch) { return std::towlower(ch); });
+  return extension == L".xml";
+}
+
+inline bool ReadInputDocument(pugi::xml_document &document,
+                              const std::filesystem::path &path,
+                              pugi::xml_parse_result &result) {
+  result = document.load_file(path.c_str());
+  if (!result || !document.child("bindings")) {
+    // pugixml can leave a partial tree after a parse failure. Never merge it.
+    document.reset();
+    return false;
+  }
+  return true;
+}
+
+inline const char *KeyAttribute(std::string_view name) {
+  if (name == "hold" || name == "multitap" || name == "repeat" ||
+      name == "toggle" || name == "acceptedEvents")
+    return "action";
+  if (name == "buttonGroup")
+    return "id";
+  if (name == "blend")
+    return nullptr;
+  return "name";
+}
+
+enum class MergeResult { Added, Appended, Replaced, Unsupported, MissingBindings };
+
+inline MergeResult MergeBinding(pugi::xml_document &contexts,
+                                pugi::xml_document &mappings,
+                                pugi::xml_node node) {
+  const std::string_view name = node.name();
+  pugi::xml_document *document;
+  if (name == "blend" || name == "context" || name == "hold" ||
+      name == "multitap" || name == "repeat" || name == "toggle" ||
+      name == "acceptedEvents") {
+    document = &contexts;
+  } else if (name == "mapping" || name == "buttonGroup" ||
+             name == "pairedAxes" || name == "preset") {
+    document = &mappings;
+  } else {
+    return MergeResult::Unsupported;
+  }
+  auto bindings = document->child("bindings");
+  if (!bindings)
+    return MergeResult::MissingBindings;
+  pugi::xml_node existing;
+  if (const char *key = KeyAttribute(name)) {
+    auto id = node.attribute(key);
+    if (id && *id.value())
+      existing = bindings.find_child_by_attribute(node.name(), key, id.value());
+  }
+  if (!existing) {
+    bindings.append_copy(node);
+    return MergeResult::Added;
+  }
+  if (node.attribute("append").as_bool()) {
+    for (auto child : node.children())
+      existing.append_copy(child);
+    return MergeResult::Appended;
+  }
+  bindings.remove_child(existing);
+  bindings.append_copy(node);
+  return MergeResult::Replaced;
+}
+
+} // namespace InputLoader
