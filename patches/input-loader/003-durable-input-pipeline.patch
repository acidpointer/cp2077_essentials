+namespace InputLoader {
+namespace fs = std::filesystem;
+inline const std::string NeutralIni = "; Input Loader essentials: neutral until a complete cache pair is ready\n[Player/Input]\n";
+inline const std::string ManagedMarker = "; Input Loader essentials generation v1\r\n";
+
+struct Storage {
+  virtual ~Storage() = default;
+  virtual bool Exists(const fs::path& path) = 0;
+  virtual std::string Read(const fs::path& path) = 0;
+  virtual void Directories(const fs::path& path) = 0;
+  virtual void Write(const fs::path& path, const std::string& text) = 0; // flush AND close, or throw
+  virtual void Replace(const fs::path& temporary, const fs::path& target) = 0;
+  virtual std::string Unique() = 0;
+};
+struct Selection {
+  std::string ini, contexts, mappings;
+};
+inline std::string Trim(std::string text) {
+  const auto first = text.find_first_not_of(" \t\r\n");
+  if (first == std::string::npos) return {};
+  return text.substr(first, text.find_last_not_of(" \t\r\n") - first + 1);
+}
+struct IniPaths { std::string contexts, mappings, scope; bool managed = false; };
+inline std::optional<IniPaths> ReadSelector(const std::string& text) {
+  IniPaths paths;
+  paths.managed = text.rfind(ManagedMarker, 0) == 0;
+  size_t at = 0;
+  bool section = false;
+  while (at < text.size()) {
+    const auto end = text.find('\n', at);
+    const auto line = Trim(text.substr(at, end == std::string::npos ? end : end - at));
+    at = end == std::string::npos ? text.size() : end + 1;
+    if (line.empty() || line[0] == ';') continue;
+    if (line == "[Player/Input]" && !section) { section = true; continue; }
+    if (!section) return {};
+    const auto equal = line.find('=');
+    if (equal == std::string::npos) return {};
+    const auto key = Trim(line.substr(0, equal));
+    const auto value = Trim(line.substr(equal + 1));
+    if (value.size() < 2 || value.front() != '"' || value.back() != '"') return {};
+    auto* target = key == "InputContextFile" ? &paths.contexts : key == "InputMappingFile" ? &paths.mappings : nullptr;
+    if (!target || !target->empty()) return {};
+    *target = value.substr(1, value.size() - 2);
+  }
+  if (!section) return {};
+  if (paths.contexts.empty() && paths.mappings.empty()) return paths;
+  if (!paths.managed) {
+    if (paths.contexts != "cache\\inputContexts.xml" || paths.mappings != "cache\\inputUserMappings.xml") return {};
+    return paths; // recognizable legacy shipped selector
+  }
+  const std::string prefix = "cache\\input_loader\\";
+  if (paths.contexts.rfind(prefix, 0) != 0) return {};
+  const auto scopeEnd = paths.contexts.find('\\', prefix.size());
+  if (scopeEnd == std::string::npos) return {};
+  paths.scope = paths.contexts.substr(prefix.size(), scopeEnd - prefix.size());
+  if (paths.scope.rfind("game-", 0) != 0 || paths.scope.substr(5).empty() ||
+      paths.scope.substr(5).find_first_not_of("0123456789-") != std::string::npos) return {};
+  const auto generationPrefix = prefix + paths.scope + "\\";
+  const auto slash = paths.contexts.find('\\', generationPrefix.size());
+  if (slash == std::string::npos) return {};
+  const auto id = paths.contexts.substr(generationPrefix.size(), slash - generationPrefix.size());
+  if (id.empty() || id.find_first_not_of("0123456789abcdef-") != std::string::npos) return {};
+  if (paths.contexts.substr(slash + 1) != "inputContexts.xml" ||
+      paths.mappings != generationPrefix + id + "\\inputUserMappings.xml") return {};
+  return paths;
+}
+inline std::string Selector(const std::string& id, const std::string& scope) {
+  const std::string prefix = "cache\\input_loader\\" + scope + "\\" + id + "\\";
+  return ManagedMarker + "[Player/Input]\r\nInputContextFile = \"" + prefix +
+         "inputContexts.xml\"\r\nInputMappingFile = \"" + prefix + "inputUserMappings.xml\"\r\n";
