index 0000000000000000000000000000000000000000..2f21e5a12ad165c7d946e3fb99dc546a16825076
--- /dev/null
+++ b/src/Files.cpp
@@ -0,0 +1,166 @@
+#include "stdafx.hpp"
+#include "Files.hpp"
+#include <bcrypt.h>
+#include <array>
+#include <system_error>
+
+namespace InputLoader {
+namespace {
+[[noreturn]] void Failed(const char* operation) {
+  throw std::system_error(static_cast<int>(GetLastError()), std::system_category(), operation);
+}
+struct Handle {
+  HANDLE value;
+  explicit Handle(HANDLE h) : value(h) {}
+  ~Handle() { if (value != INVALID_HANDLE_VALUE) CloseHandle(value); }
+  Handle(const Handle&) = delete;
+  Handle& operator=(const Handle&) = delete;
+};
+std::wstring NativePath(const fs::path& path) {
+  auto name = fs::absolute(path).lexically_normal().wstring();
+  if (name.rfind(L"\\\\?\\", 0) == 0) return name;
+  if (name.rfind(L"\\\\", 0) == 0) return L"\\\\?\\UNC\\" + name.substr(2);
+  return L"\\\\?\\" + name;
+}
+std::string Hex(const unsigned char* bytes, size_t size) {
+  const char* digits = "0123456789abcdef";
+  std::string text;
+  for (size_t i = 0; i < size; ++i) { text += digits[bytes[i] >> 4]; text += digits[bytes[i] & 15]; }
+  return text;
+}
+}
+std::string Hash(const std::string& first, const std::string& second) {
+  BCRYPT_ALG_HANDLE algorithm = nullptr;
+  BCRYPT_HASH_HANDLE hash = nullptr;
+  if (!BCRYPT_SUCCESS(BCryptOpenAlgorithmProvider(&algorithm, BCRYPT_SHA256_ALGORITHM, nullptr, 0)))
+    throw std::runtime_error("SHA256 provider unavailable");
+  try {
+    if (!BCRYPT_SUCCESS(BCryptCreateHash(algorithm, &hash, nullptr, 0, nullptr, 0, 0)))
+      throw std::runtime_error("SHA256 initialization failed");
+    for (const auto* text : {&first, &second}) {
+      size_t position = 0;
+      while (position < text->size()) {
+        const auto size = static_cast<ULONG>(std::min<size_t>(65536, text->size() - position));
+        if (!BCRYPT_SUCCESS(BCryptHashData(hash, reinterpret_cast<PUCHAR>(const_cast<char*>(text->data() + position)), size, 0)))
+          throw std::runtime_error("SHA256 update failed");
+        position += size;
+      }
+      // Length framing distinguishes different pairs with the same concatenation.
+      const uint64_t length = text->size();
+      if (!BCRYPT_SUCCESS(BCryptHashData(hash, reinterpret_cast<PUCHAR>(const_cast<uint64_t*>(&length)), sizeof(length), 0)))
+        throw std::runtime_error("SHA256 framing failed");
+    }
+    std::array<unsigned char, 32> digest{};
+    if (!BCRYPT_SUCCESS(BCryptFinishHash(hash, digest.data(), static_cast<ULONG>(digest.size()), 0)))
+      throw std::runtime_error("SHA256 finalization failed");
+    BCryptDestroyHash(hash); hash = nullptr;
+    BCryptCloseAlgorithmProvider(algorithm, 0); algorithm = nullptr;
+    return Hex(digest.data(), digest.size());
+  } catch (...) {
+    if (hash) BCryptDestroyHash(hash);
+    if (algorithm) BCryptCloseAlgorithmProvider(algorithm, 0);
+    throw;
+  }
+}
+std::string Utf8(const fs::path& path) {
+  const auto text = path.generic_u8string();
+  return {reinterpret_cast<const char*>(text.data()), text.size()};
+}
+fs::path Canonical(const fs::path& path) { return fs::canonical(path); }
+bool LinkedDirectory(const fs::path& path) {
+  const auto attributes = GetFileAttributesW(NativePath(path).c_str());
+  if (attributes == INVALID_FILE_ATTRIBUTES) Failed("stat input directory");
+  return (attributes & FILE_ATTRIBUTE_DIRECTORY) && (attributes & FILE_ATTRIBUTE_REPARSE_POINT);
+}
+std::wstring PathKey(const fs::path& path) {
+  // Windows ordinal case folding is independent of the process's C locale.
+  const auto text = path.lexically_normal().generic_wstring();
+  if (text.size() > INT_MAX) throw std::length_error("path is too long");
+  const auto size = static_cast<int>(text.size());
+  const int needed = LCMapStringEx(LOCALE_NAME_INVARIANT, LCMAP_UPPERCASE, text.data(), size, nullptr, 0, nullptr, nullptr, 0);
+  if (!needed) Failed("normalize path");
+  std::wstring result(needed, L'\0');
+  if (!LCMapStringEx(LOCALE_NAME_INVARIANT, LCMAP_UPPERCASE, text.data(), size, result.data(), needed, nullptr, nullptr, 0))
+    Failed("normalize path");
+  return result;
+}
+fs::path ModuleFile(HMODULE module) {
+  for (size_t capacity = MAX_PATH + 1; capacity <= 65536; capacity *= 2) {
+    std::wstring text(capacity, L'\0');
+    const DWORD size = GetModuleFileNameW(module, text.data(), static_cast<DWORD>(text.size()));
+    if (!size) Failed("GetModuleFileNameW");
+    if (size < text.size()) { text.resize(size); return fs::path(text); }
+  }
+  throw std::length_error("module path exceeds Windows path limit");
+}
+bool NativeStorage::Exists(const fs::path& path) {
+  const DWORD attrs = GetFileAttributesW(NativePath(path).c_str());
+  if (attrs != INVALID_FILE_ATTRIBUTES) return true;
+  const auto code = GetLastError();
+  if (code == ERROR_FILE_NOT_FOUND || code == ERROR_PATH_NOT_FOUND) return false;
+  Failed("stat file");
+}
+std::string NativeStorage::Read(const fs::path& path) {
+  return Snapshot(path).first;
+}
+std::pair<std::string, std::string> NativeStorage::Snapshot(const fs::path& path) {
+  Handle file(CreateFileW(NativePath(path).c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr));
+  if (file.value == INVALID_HANDLE_VALUE) Failed("open input");
+  FILE_ID_INFO identity{};
+  if (!GetFileInformationByHandleEx(file.value, FileIdInfo, &identity, sizeof(identity))) Failed("identify input file");
+  const auto key = Hex(reinterpret_cast<const unsigned char*>(&identity.VolumeSerialNumber), sizeof(identity.VolumeSerialNumber)) +
+                   Hex(identity.FileId.Identifier, sizeof(identity.FileId.Identifier));
+  std::string text;
+  std::array<char, 65536> buffer{};
+  for (;;) {
+    DWORD size = 0;
+    if (!ReadFile(file.value, buffer.data(), static_cast<DWORD>(buffer.size()), &size, nullptr)) Failed("read input");
+    if (!size) break;
+    text.append(buffer.data(), size);
+  }
+  return {std::move(text), key};
+}
+void NativeStorage::Directories(const fs::path& path) { fs::create_directories(fs::path(NativePath(path))); }
+void NativeStorage::Write(const fs::path& path, const std::string& text) {
+  // Generation files and selector temporaries must never replace an existing file.
+  Handle file(CreateFileW(NativePath(path).c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr));
+  if (file.value == INVALID_HANDLE_VALUE) Failed("create staged file");
+  size_t offset = 0;
+  while (offset < text.size()) {
+    DWORD written = 0;
+    const auto size = static_cast<DWORD>(std::min<size_t>(65536, text.size() - offset));
+    if (!WriteFile(file.value, text.data() + offset, size, &written, nullptr)) Failed("write staged file");
+    if (!written) throw std::runtime_error("staged write made no progress");
+    offset += written;
+  }
+  if (!FlushFileBuffers(file.value)) Failed("flush staged file");
+  const HANDLE closing = file.value;
+  file.value = INVALID_HANDLE_VALUE;
+  if (!CloseHandle(closing)) Failed("close staged file");
+}
+void NativeStorage::Replace(const fs::path& temporary, const fs::path& target) {
+  if (!MoveFileExW(NativePath(temporary).c_str(), NativePath(target).c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+    Failed("commit input selector");
+}
+std::string NativeStorage::Unique() {
+  std::array<unsigned char, 16> bytes{};
+  if (!BCRYPT_SUCCESS(BCryptGenRandom(nullptr, bytes.data(), static_cast<ULONG>(bytes.size()), BCRYPT_USE_SYSTEM_PREFERRED_RNG)))
+    throw std::runtime_error("generation nonce unavailable");
+  return Hex(bytes.data(), bytes.size());
+}
+PublicationLock::PublicationLock(const fs::path& root) {
+  NativeStorage io;
+  const auto directory = root / "engine/config/platform/pc";
+  io.Directories(directory);
+  const auto path = NativePath(directory / ".input_loader.lock");
+  for (int attempt = 0; attempt < 500; ++attempt) {
+    handle = CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (handle != INVALID_HANDLE_VALUE) return;
+    const auto error = GetLastError();
+    if (error != ERROR_SHARING_VIOLATION && error != ERROR_LOCK_VIOLATION) Failed("lock input publication");
+    Sleep(10);
+  }
+  throw std::runtime_error("input publication lock timed out; previous configuration preserved");
+}
+PublicationLock::~PublicationLock() { if (handle != INVALID_HANDLE_VALUE) CloseHandle(handle); }
+} // namespace InputLoader
