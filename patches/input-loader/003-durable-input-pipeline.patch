+#pragma once
+#include "Store.hpp"
+#include <Windows.h>
+
+namespace InputLoader {
+std::string Hash(const std::string& first, const std::string& second = {});
+std::string Utf8(const std::filesystem::path& path);
+std::wstring PathKey(const std::filesystem::path& path);
+std::filesystem::path Canonical(const std::filesystem::path& path);
+std::filesystem::path ModuleFile(HMODULE module);
+bool LinkedDirectory(const std::filesystem::path& path);
+
+struct NativeStorage : Storage {
+  // Content and file identity are read through the same handle, with writes and
+  // replacement denied until the snapshot is complete.
+  std::pair<std::string, std::string> Snapshot(const fs::path& path);
+  bool Exists(const fs::path& path) override;
+  std::string Read(const fs::path& path) override;
+  void Directories(const fs::path& path) override;
+  void Write(const fs::path& path, const std::string& text) override;
+  void Replace(const fs::path& temporary, const fs::path& target) override;
+  std::string Unique() override;
+};
+class PublicationLock {
+  HANDLE handle = INVALID_HANDLE_VALUE;
+public:
+  explicit PublicationLock(const fs::path& root);
+  ~PublicationLock();
+  PublicationLock(const PublicationLock&) = delete;
+  PublicationLock& operator=(const PublicationLock&) = delete;
+};
+} // namespace InputLoader
