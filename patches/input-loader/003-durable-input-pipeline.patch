+  fs::path root;
+  std::string scope;
+  std::optional<Selection> active;
+  bool owned = false;
+  bool journalFailed = false;
+  fs::path Ini() const { return root / "engine/config/platform/pc/input_loader.ini"; }
+  fs::path Cache() const { return root / "r6/cache/input_loader" / scope; }
+  void Atomic(const fs::path& target, const std::string& text) {
+    io.Directories(target.parent_path());
