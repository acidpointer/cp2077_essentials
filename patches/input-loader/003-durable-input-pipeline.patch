+    } catch (const std::bad_alloc&) { throw; } catch (...) { active.reset(); }
+    if (active) Atomic(Ini(), active->ini);
+    else if (text != NeutralIni) Atomic(Ini(), NeutralIni);
+  }
+  bool Publish(const std::string& contexts, const std::string& mappings, const std::string& hash) {
+    if (!owned) throw std::runtime_error("store was not recovered");
+    if (hash.size() != 64 || hash.find_first_not_of("0123456789abcdef") != std::string::npos)
+      throw std::runtime_error("invalid generation identity");
+    pugi::xml_document c, m;
+    if (!ParseDocument(c, contexts) || !ParseDocument(m, mappings) || !ValidPair(c, m))
+      throw std::runtime_error("candidate pair failed validation");
+    if (active && active->contexts == contexts && active->mappings == mappings) return false;
+    std::string id = hash;
+    auto directory = Cache() / id;
+    bool reuse = false;
+    if (io.Exists(directory)) {
+      try { reuse = io.Read(directory / "inputContexts.xml") == contexts && io.Read(directory / "inputUserMappings.xml") == mappings; }
+      catch (const std::bad_alloc&) { throw; } catch (...) {}
+      // Never repair an existing (possibly referenced) generation in place.
+      if (!reuse) { id += "-" + io.Unique(); directory = Cache() / id; }
+    }
+    if (!reuse) {
+      io.Directories(directory);
+      io.Write(directory / "inputContexts.xml", contexts);
+      io.Write(directory / "inputUserMappings.xml", mappings);
+      if (io.Read(directory / "inputContexts.xml") != contexts || io.Read(directory / "inputUserMappings.xml") != mappings)
+        throw std::runtime_error("generation verification failed");
+    }
+    auto next = Selection{Selector(id, scope), contexts, mappings};
+    Atomic(Ini(), next.ini); // the only activation point
+    active = std::move(next);
+    // The engine selector is already committed. Journal failure cannot turn a
+    // successful publication into a reported failure or undo the valid pair.
+    journalFailed = false;
+    try { Atomic(Cache() / "last-good.ini", active->ini); } catch (...) { journalFailed = true; }
+    return true;
+  }
+};
+} // namespace InputLoader
