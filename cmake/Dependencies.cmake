set(dep "${ESSENTIALS_ROOT}/build/deps")
set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(SPDLOG_INSTALL OFF CACHE BOOL "" FORCE)
set(SPDLOG_FMT_EXTERNAL OFF CACHE BOOL "" FORCE)
set(YAML_CPP_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(YAML_CPP_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(YAML_CPP_INSTALL OFF CACHE BOOL "" FORCE)
set(YAML_BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(MI_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(MI_BUILD_OBJECT OFF CACHE BOOL "" FORCE)
set(MI_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(MI_OVERRIDE OFF CACHE BOOL "" FORCE)
add_subdirectory("${dep}/mimalloc" deps/mimalloc EXCLUDE_FROM_ALL)
add_subdirectory("${dep}/minhook" deps/minhook EXCLUDE_FROM_ALL)
add_subdirectory("${dep}/yaml-cpp" deps/yaml-cpp EXCLUDE_FROM_ALL)
add_subdirectory("${dep}/spdlog" deps/spdlog EXCLUDE_FROM_ALL)
# Match TiltedCore's xmake source set and installed header layout.
file(GLOB tilted_sources CONFIGURE_DEPENDS "${dep}/tiltedcore/Code/core/src/*.cpp")
file(GLOB tilted_headers "${dep}/tiltedcore/Code/core/include/*.hpp")
foreach(header IN LISTS tilted_headers)
  get_filename_component(name "${header}" NAME)
  configure_file("${header}" "${CMAKE_BINARY_DIR}/include/TiltedCore/${name}" COPYONLY)
endforeach()
add_library(TiltedCore STATIC ${tilted_sources})
target_include_directories(TiltedCore PUBLIC "${CMAKE_BINARY_DIR}/include"
  PRIVATE "${dep}/tiltedcore/Code/core/include")
target_include_directories(TiltedCore SYSTEM PUBLIC "${dep}/hopscotch-map/include")
target_link_libraries(TiltedCore PUBLIC mimalloc-static)
